---
import BaseLayout from "./BaseLayout.astro";
import SiteNav from "../components/landing/SiteNav.astro";
import type { Lang } from "../i18n/ui";

interface Props {
   title: string;
   lang: Lang;
}
const { title, lang } = Astro.props;
---

<BaseLayout title={`${title} | MasterClass HPE`} lang={lang} noindex>
   <SiteNav slot="header" lang={lang} home={false} />
   <main class="relative isolate overflow-hidden px-4 py-16 md:py-28">
      <div class="pointer-events-none absolute top-0 left-1/2 -z-10 size-[44rem] -translate-x-1/2 -translate-y-1/3 animate-float rounded-full bg-[radial-gradient(circle,var(--glow),transparent_65%)]" aria-hidden="true"></div>
      <div class="mx-auto w-full max-w-md animate-[hero-in_.9s_cubic-bezier(.16,1,.3,1)]">
         <slot />
      </div>
   </main>
</BaseLayout>
