---
import SectionHeader from "./SectionHeader.astro";
import { useT, type Lang } from "../../i18n/ui";
import { SESIONES } from "../../i18n/landing";

interface Props {
   lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="modulos" class="section bg-surface">
   <div class="container-x">
      <SectionHeader tag={t("prog-tag")} title={t("prog-title")} lead={t("prog-lead")} />
      <div class="mx-auto mt-14 max-w-5xl border-t border-line">
         {
            SESIONES.map(({ n, speaker }) => (
               <details class="acordeon group border-b border-line">
                  <summary class="grid min-h-11 cursor-pointer list-none grid-cols-[3rem_1fr_auto] items-start gap-4 py-6 md:grid-cols-[5rem_1fr_auto] md:gap-6 [&::-webkit-details-marker]:hidden">
                     <span class="text-3xl font-light tracking-[-0.03em] text-muted tabular-nums transition-colors duration-300 group-open:text-hpe-dark md:text-4xl" aria-hidden="true">
                        0{n}
                     </span>
                     <!-- Diap. 10: título corto; diap. 11–16: título con el enfoque, ponente y fecha 2027 confirmada. -->
                     <span class="block min-w-0">
                        <span class="block text-lg font-medium md:text-2xl">{t(`s${n}-short`)}</span>
                        <span class="mt-1 block text-ink-soft md:text-lg">{t(`s${n}-title`)}</span>
                        <span class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
                           <span>{t(`s${n}-date`)}</span>
                           <span>
                              {t("prog-speaker")}: {speaker}
                           </span>
                        </span>
                     </span>
                     <span class="mas-menos mt-1" aria-hidden="true"></span>
                  </summary>
                  <ul class="stagger-open grid gap-3 pb-7 md:ml-[6.5rem] md:grid-cols-3">
                     {([1, 2, 3] as const).map((p) => (
                        <li class="flex gap-3 rounded-2xl border border-line bg-card p-5 text-sm leading-relaxed text-ink-soft">
                           <span class="font-semibold text-hpe-dark tabular-nums" aria-hidden="true">{p}</span>
                           <span>{t(`s${n}-p${p}`)}</span>
                        </li>
                     ))}
                  </ul>
               </details>
            ))
         }
         <div class="flex justify-center pt-10">
            <a href="#registro" class="btn btn-primary px-7 py-3.5" data-track="cta" data-track-ubicacion="programa">{t("prog-cta")}</a>
         </div>
      </div>
   </div>
</section>
