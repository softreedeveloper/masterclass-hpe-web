---
import { Image } from "astro:assets";
import SectionHeader from "./SectionHeader.astro";
import { useT, type Lang } from "../../i18n/ui";
import { SESIONES } from "../../i18n/landing";
import { PERFILES, PERFILES_PRELIMINARES } from "../../data/speakers";

interface Props {
   lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// Diap. 17: retícula 3×2 (una columna en móvil), mismo orden del programa. Cada tarjeta abre un modal con el perfil.
// Foto, cargo y bio son genéricos hasta que HPE los apruebe (ver src/data/speakers.ts).
const iniciales = (nombre: string) => {
   const partes = nombre.split(" ");
   return partes[0][0] + partes[partes.length - 1][0];
};
const speakers = SESIONES.map(({ n, speaker }) => {
   const perfil = PERFILES.find((p) => p.n === n);
   return {
      n,
      nombre: speaker,
      foto: perfil?.foto,
      ini: perfil?.iniciales ?? iniciales(speaker),
      cargo: perfil?.cargo?.[lang] ?? t("spk-cargo-gen"),
      bio: perfil?.bio?.[lang] ?? t("spk-bio-gen").replace("{titulo}", t(`s${n}-title`)),
   };
});
---

<section id="speakers" class="section">
   <div class="container-x">
      <SectionHeader tag={t("spk-tag")} title={t("spk-title")} lead={t("spk-lead")} />
      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
         {
            speakers.map(({ n, nombre, foto, ini }) => (
               <li class="reveal" style={`--d:${(n - 1) % 3}`}>
                  <button type="button" class="spk-card fx-card" data-abre-speaker={`spk-modal-${n}`} aria-haspopup="dialog">
                     <span class="spk-avatar" aria-hidden="true">
                        {foto ? <Image src={foto} alt="" width={128} height={128} loading="lazy" class="spk-foto" /> : ini}
                     </span>
                     <span class="min-w-0 flex-1 text-left">
                        <span class="block text-lg font-medium">{nombre}</span>
                        <span class="mt-1 block text-sm text-ink-soft">
                           M0{n} · {t(`s${n}-short`)}
                        </span>
                        <span class="spk-ver">
                           {t("spk-ver")}
                           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                              <path d="M5 12h13M13 6l6 6-6 6" />
                           </svg>
                        </span>
                     </span>
                  </button>
               </li>
            ))
         }
      </ul>
   </div>

   {
      speakers.map(({ n, nombre, foto, ini, cargo, bio }) => (
         <dialog id={`spk-modal-${n}`} class="spk-modal" aria-labelledby={`spk-modal-${n}-h`}>
            <div class="spk-modal-cabecera">
               <span class="spk-avatar spk-avatar-lg" aria-hidden={foto ? undefined : "true"}>
                  {foto ? <Image src={foto} alt={t("spk-foto-alt").replace("{nombre}", nombre)} width={176} height={176} loading="lazy" class="spk-foto" /> : ini}
               </span>
               <div class="min-w-0">
                  {PERFILES_PRELIMINARES && <span class="spk-chip">{t("spk-preliminar")}</span>}
                  <h3 id={`spk-modal-${n}-h`} class="mt-2 text-2xl font-medium md:text-3xl">
                     {nombre}
                  </h3>
                  <p class="mt-1 text-ink-soft">{cargo}</p>
               </div>
               <button type="button" class="spk-cerrar" data-cierra-speaker aria-label={t("spk-cerrar")}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                     <path d="M6 6l12 12M18 6L6 18" />
                  </svg>
               </button>
            </div>
            <div class="spk-modal-cuerpo">
               <div class="spk-sesion">
                  <p class="text-xs font-medium tracking-[0.16em] text-hpe-dark uppercase">
                     {t("spk-sesion")} 0{n} · {t(`s${n}-date`)}
                  </p>
                  <p class="mt-2 text-lg font-medium">{t(`s${n}-short`)}</p>
                  <p class="mt-1 text-ink-soft">{t(`s${n}-title`)}</p>
               </div>
               <h4 class="mt-7 text-sm font-medium text-muted">{t("spk-bio-h")}</h4>
               <p class="mt-2 leading-relaxed text-ink">{bio}</p>
               <h4 class="mt-7 text-sm font-medium text-muted">{t("spk-temas")}</h4>
               <ol class="mt-3 space-y-2.5">
                  {([1, 2, 3] as const).map((p) => (
                     <li class="flex gap-3 leading-relaxed text-ink-soft">
                        <span class="spk-punto" aria-hidden="true">
                           {p}
                        </span>
                        <span>{t(`s${n}-p${p}`)}</span>
                     </li>
                  ))}
               </ol>
            </div>
         </dialog>
      ))
   }
</section>

<script>
   // Modal nativo <dialog>: foco atrapado y Escape los da el navegador; el foco vuelve a la tarjeta al cerrar.
   document.querySelectorAll<HTMLButtonElement>("[data-abre-speaker]").forEach((btn) => {
      const modal = document.getElementById(btn.dataset.abreSpeaker!) as HTMLDialogElement | null;
      if (!modal) return;
      btn.addEventListener("click", () => {
         modal.showModal();
         document.documentElement.style.overflow = "hidden";
      });
      modal.addEventListener("close", () => {
         document.documentElement.style.overflow = "";
         btn.focus({ preventScroll: true });
      });
      // Clic fuera del contenido (sobre el fondo) cierra.
      modal.addEventListener("click", (e) => {
         if (e.target === modal) modal.close();
      });
      modal.querySelectorAll("[data-cierra-speaker]").forEach((c) => c.addEventListener("click", () => modal.close()));
   });
</script>
