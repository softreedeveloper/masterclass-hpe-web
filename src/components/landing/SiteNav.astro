---
import { useT, otroLang, type Lang } from "../../i18n/ui";
import { Image } from "astro:assets";
import ThemeToggle from "../ui/ThemeToggle.astro";
// Logotipo oficial HPE (Docs/PNG): positivo en tema claro, negativo (rev) en oscuro.
import logoPos from "../../assets/hpe-logo.png";
import logoRev from "../../assets/hpe-logo-rev.png";

interface Props {
   lang: Lang;
   home?: boolean;
}
const { lang, home = true } = Astro.props;
const t = useT(lang);
const base = `/${lang}/`;
const href = (ancla: string) => (home ? `#${ancla}` : `${base}#${ancla}`);
// Orden y nombres de la diap. 3: Inicio | Mercado | Enfoque consultivo | Para quién (audiencia) | Programa | Speakers | Acreditación | Preguntas | [Regístrate]
const links = [
   ["hero", "nav-home"],
   ["proposito", "nav-market"],
   ["metodologias", "nav-consultive"],
   ["audiencia", "nav-audience"],
   ["modulos", "nav-program"],
   ["speakers", "nav-speakers"],
   ["acreditacion", "nav-accred"],
   ["faq", "nav-faq"],
] as const;
const otro = otroLang(lang);
const rutaOtro = Astro.url.pathname.replace(/^\/(es|en)(?=\/|$)/, `/${otro}`) + Astro.url.search;
---

<header id="siteNav" class="group/nav sticky top-0 z-30">
   <div
      class="relative border-b border-transparent bg-[var(--nav-bg)] backdrop-blur-xl backdrop-saturate-150 transition-[border-color,box-shadow] duration-500 group-[.is-scrolled]/nav:border-line"
   >
      <span class="scroll-progress" aria-hidden="true"></span>
      <div
         class="container-x flex h-[72px] max-w-[90rem] items-center justify-between gap-3 transition-[height] duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-[.is-scrolled]/nav:h-16"
      >
         <a href={base} class="flex min-w-0 items-center gap-2 sm:gap-3" aria-label="HPE Master Class">
            <span class="flex h-6 shrink-0 items-center">
               <Image src={logoPos} alt="" width={168} class="h-6 w-auto dark:hidden" loading="eager" />
               <Image src={logoRev} alt="" width={168} class="hidden h-6 w-auto dark:block" loading="eager" />
            </span>
            <span class="h-7 w-px shrink-0 bg-line" aria-hidden="true"></span>
            <span class="truncate text-[13px] font-semibold tracking-[0.16em] whitespace-nowrap sm:hidden">MASTER CLASS</span>
            <span class="hidden min-w-0 overflow-hidden leading-tight sm:block">
               <span class="block truncate text-[13px] font-semibold tracking-[0.2em] whitespace-nowrap">MASTER CLASS</span>
               <span class="block text-[11px] whitespace-nowrap text-muted">{t("brand-subtitle")}</span>
            </span>
         </a>
         <nav class="hidden min-[1280px]:block" aria-label={t("nav-label")}>
            <ul class="flex items-center text-[13px] whitespace-nowrap">
               {
                  links.map(([ancla, key]) => (
                     <li>
                        <a
                           href={href(ancla)}
                           data-seccion={ancla}
                           class="nav-underline block px-2.5 py-2.5 min-[1440px]:px-3 text-ink-soft transition-colors hover:text-ink"
                        >
                           {t(key)}
                        </a>
                     </li>
                  ))
               }
            </ul>
         </nav>
         <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
            <a href={`${base}login`} class="btn btn-ghost btn-sm hidden lg:inline-flex">{t("nav-login")}</a>
            <a href={href("registro")} class="btn btn-primary btn-sm hidden min-[360px]:inline-flex max-[1279px]:group-[.menu-open]/nav:invisible" data-track="cta" data-track-ubicacion="header">{t("nav-cta")}</a>
            <a
               href={rutaOtro}
               class="hidden size-10 sm:grid place-items-center rounded-lg border border-line px-2.5 text-[11px] font-semibold tracking-wider text-ink-soft transition-colors hover:border-line-strong hover:text-ink"
               hreflang={otro}
               aria-label={otro === "en" ? "Switch to English" : "Cambiar a español"}>{otro.toUpperCase()}</a
            >
            <span class="hidden sm:contents"><ThemeToggle /></span>
            <button
               id="navToggle"
               class="grid size-11 place-items-center rounded-lg text-ink hover:bg-surface min-[1280px]:hidden"
               aria-label={t("nav-menu")}
               aria-expanded="false"
               aria-controls="navDrawer"
            >
               <span class="relative block h-3 w-[18px]" aria-hidden="true">
                  <span class="nav-bar absolute top-0 left-0 h-[1.5px] w-full bg-current transition-transform duration-300"></span>
                  <span class="nav-bar absolute bottom-0 left-0 h-[1.5px] w-full bg-current transition-transform duration-300"></span>
               </span>
            </button>
         </div>
      </div>
   </div>
   <div
      id="navDrawer"
      inert
      class="grid grid-rows-[0fr] border-b border-transparent bg-page transition-[grid-template-rows,border-color] duration-500 ease-[cubic-bezier(.16,1,.3,1)] data-[open=true]:grid-rows-[1fr] data-[open=true]:border-line min-[1280px]:hidden"
   >
      <div class="overflow-hidden">
         <div class="container-x max-h-[calc(100dvh-4.5rem)] overflow-y-auto pt-3 pb-5">
            <a
               href={href("registro")}
               class="nav-link btn btn-primary w-full"
               data-track="cta"
               data-track-ubicacion="menu-movil">{t("hero-cta-primary")}</a
            >
            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
               {
                  links.map(([ancla, key]) => (
                     <li>
                        <a
                           href={href(ancla)}
                           data-seccion={ancla}
                           class="nav-link nav-card flex min-h-12 items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-3 text-[15px] font-medium text-ink shadow-sm transition-colors hover:border-hpe/60"
                        >
                           {t(key)}
                           <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-muted" aria-hidden="true">
                              <path d="M9 6l6 6-6 6" />
                           </svg>
                        </a>
                     </li>
                  ))
               }
            </ul>
            <div class="mt-4 flex items-center gap-2 border-t border-line pt-4">
               <a href={`${base}login`} class="nav-link btn btn-secondary btn-sm flex-1">{t("nav-login")}</a>
               <a
                  href={rutaOtro}
                  class="grid size-11 shrink-0 place-items-center rounded-lg border border-line text-[11px] font-semibold tracking-wider text-ink-soft sm:hidden"
                  hreflang={otro}
                  aria-label={otro === "en" ? "Switch to English" : "Cambiar a español"}>{otro.toUpperCase()}</a
               >
               <span class="sm:hidden"><ThemeToggle class="size-11" /></span>
            </div>
         </div>
      </div>
   </div>
</header>

<script>
   const nav = document.getElementById("siteNav");
   const btn = document.getElementById("navToggle");
   const drawer = document.getElementById("navDrawer");
   const barras = btn?.querySelectorAll<HTMLElement>(".nav-bar");
   const setAbierto = (abierto: boolean) => {
      drawer?.setAttribute("data-open", String(abierto));
      nav?.classList.toggle("menu-open", abierto);
      // Cerrado, el menú no debe recibir foco ni leerse.
      if (drawer) drawer.inert = !abierto;
      btn?.setAttribute("aria-expanded", String(abierto));
      if (barras) {
         barras[0].style.transform = abierto ? "translateY(5px) rotate(45deg)" : "";
         barras[1].style.transform = abierto ? "translateY(-5px) rotate(-45deg)" : "";
      }
   };
   btn?.addEventListener("click", () => setAbierto(drawer?.getAttribute("data-open") !== "true"));
   document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer?.getAttribute("data-open") === "true") {
         setAbierto(false);
         btn?.focus();
      }
   });
   drawer?.querySelectorAll(".nav-link").forEach((a) => a.addEventListener("click", () => setAbierto(false)));

   // Barra compacta con borde al bajar.
   const onScroll = () => nav?.classList.toggle("is-scrolled", window.scrollY > 120);
   onScroll();
   window.addEventListener("scroll", onScroll, { passive: true });

   // Resalta el enlace de la última sección cuyo inicio ya pasó la línea de lectura (0.4 de la pantalla).
   const enlaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-seccion]")];
   const secciones = enlaces.map((a) => document.getElementById(a.dataset.seccion!));
   let pendiente = false;
   const marcar = () => {
      pendiente = false;
      const linea = window.innerHeight * 0.4;
      let actual = -1;
      secciones.forEach((s, i) => {
         if (s && s.getBoundingClientRect().top <= linea && s.getBoundingClientRect().bottom > 0) actual = i;
      });
      enlaces.forEach((a, i) => a.setAttribute("aria-current", String(i === actual)));
   };
   if (enlaces.length) {
      marcar();
      window.addEventListener(
         "scroll",
         () => {
            if (!pendiente) {
               pendiente = true;
               requestAnimationFrame(marcar);
            }
         },
         { passive: true },
      );
   }
</script>
