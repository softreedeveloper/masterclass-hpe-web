---
// Botón sol/luna; el ícono visible depende de la clase .dark en <html>.
interface Props {
   class?: string;
}
const { class: clase = "" } = Astro.props;
---

<button
   type="button"
   data-theme-toggle
   class:list={[
      "group relative grid size-9 place-items-center rounded-lg border border-line text-ink-soft transition-colors hover:border-line-strong hover:text-ink",
      clase,
   ]}
   aria-label="Cambiar tema claro/oscuro"
   title="Cambiar tema"
>
   <svg
      class="absolute size-[18px] rotate-0 scale-100 transition-all duration-500 ease-[cubic-bezier(.16,1,.3,1)] dark:-rotate-90 dark:scale-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
   >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
   </svg>
   <svg
      class="absolute size-[18px] rotate-90 scale-0 transition-all duration-500 ease-[cubic-bezier(.16,1,.3,1)] dark:rotate-0 dark:scale-100"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
   >
      <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
   </svg>
</button>

<script>
   import { alternarTema } from "../../lib/tema";
   document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((b) => {
      b.addEventListener("click", () => {
         const r = b.getBoundingClientRect();
         alternarTema({ x: r.left + r.width / 2, y: r.top + r.height / 2 });
      });
   });
</script>
